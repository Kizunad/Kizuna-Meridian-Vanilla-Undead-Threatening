schema_version: 1
namespace: "meridian_undead"
binding_templates { id: "meridian_undead:corpse" version: 1 }

definitions {
  id: "meridian_undead:leap"
  version: 1
  category: MOVEMENT
  minimum_realm: WANDERING_QI
  innate: true
  innate_unlock {
    opened_meridian_tags: "meridian_undead:trunk"
    opened_meridian_tags: "meridian_undead:left_leg"
    opened_meridian_tags: "meridian_undead:right_leg"
  }
  slots {
    id: "pearl"
    module: ORGAN
    kind: "meridian_undead:corpse_pearl"
    minimum_count: 1
    maximum_count: 1
  }
  slots {
    id: "leg_muscles"
    module: TISSUE
    tags: "human:leg_muscle"
    minimum_count: 1
    maximum_count: 6
  }
  cost {
    qi {
      slot_id: "pearl"
      amount { value: 3 unit: QI }
      phase: FREE
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      distribution: EACH
    }
  }
  phases {
    warmup_millis: 600
    active_millis: 0
    recovery_millis: 0
    interruptible_by_damage: true
  }
  cooldown_millis: 8000
  presentation {
    icon_id: "meridian_undead:leap"
    display_name: "纵"
    description: "朽躯借腿脉一纵，扑向尚有温气的活物。"
  }
  effects {
    at_millis: 600
    status_benefit {
      id: "meridian_undead:leap"
      duration_millis: 1000
      color_rgb: 11977153
      leap {
        work {
          slot_id: "leg_muscles"
          force { value: 0 unit: NEWTON }
          power { value: 133.33333333333334 unit: WATT }
          duration { value: 0.5 unit: SECOND }
        }
        maximum_rise: 3
        maximum_drop: 4
        snap_radius: 2
        landing_delay_ticks: 20
        presentation_id: "meridian_undead:leap"
        ai_minimum_distance: 4
        ai_decision_ticks: 6
        failure_translation_key: "message.meridian_undead.weak_legs"
        maximum_path: 6
        launch_speed: 12
        minimum_flight_ticks: 6
        maximum_flight_ticks: 30
      }
    }
  }
}

definitions {
  id: "meridian_undead:bronze_hide"
  version: 1
  category: DEFENSE
  minimum_realm: WANDERING_QI
  innate: true
  innate_unlock {
    opened_meridian_tags: "meridian_undead:trunk"
    opened_meridian_tags: "meridian_undead:left_arm"
    opened_meridian_tags: "meridian_undead:right_arm"
  }
  slots {
    id: "pearl"
    module: ORGAN
    kind: "meridian_undead:corpse_pearl"
    minimum_count: 1
    maximum_count: 1
  }
  cost {
    qi {
      slot_id: "pearl"
      amount { value: 5 unit: QI }
      phase: FREE
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      distribution: EACH
    }
  }
  phases {
    warmup_millis: 500
    active_millis: 0
    recovery_millis: 0
    interruptible_by_damage: true
  }
  cooldown_millis: 30000
  presentation {
    icon_id: "meridian_undead:bronze_hide"
    display_name: "铜皮"
    description: "尸丹吐气，铜色从骨缝漫上皮肉，硬接来的拳脚。"
  }
  effects {
    at_millis: 500
    status_benefit {
      id: "meridian_undead:bronze_hide"
      duration_millis: 10000
      color_rgb: 7398305
      plain {
        movement_speed_multiplier: 0.7
      }
    }
  }
}

books { id: "meridian_undead:corpse_arts" display_name: "尸行秘录" }
volumes {
  id: "meridian_undead:corpse_movement"
  book_id: "meridian_undead:corpse_arts"
  display_name: "腾挪卷"
  techniques { id: "meridian_undead:leap" version: 1 }
  techniques { id: "meridian_undead:bronze_hide" version: 1 }
}
